# Browser-safe Supabase configuration.
# The publishable key is intended for browser applications and is protected
# by Supabase Auth + Row Level Security. Never put a secret/service-role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-public-key

# Local Express API
PORT=8787
CLIENT_URL=http://localhost:8080
VITE_API_URL=http://localhost:8787

# Server-only session/OAuth/database configuration.
SESSION_SECRET=generate-a-long-random-secret
GITHUB_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret
GITHUB_CALLBACK_URL=http://localhost:8787/api/integrations/github/callback

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-public-key
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-server-only-key
