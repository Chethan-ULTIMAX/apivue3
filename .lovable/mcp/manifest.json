{
  "version": 1,
  "sdk_version": "0.26.2",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://gfattgwchtieebnuklxw.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "sprint-companion-lovable-template",
      "version": "0.1.0",
      "title": "Sprint Companion - Lovable Template"
    },
    "tools": [
      {
        "name": "list_epics",
        "title": "List epics",
        "description": "List the workspace epics with their target quarter and dates.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50,
              "description": "Maximum rows to return."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_sprints",
        "title": "List sprints",
        "description": "List sprints with dates, goal and whether they are active.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "active_only": {
              "type": "boolean",
              "default": false,
              "description": "Return only the active sprint(s)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_tickets",
        "title": "List tickets",
        "description": "List tickets (stories) in the workspace, optionally filtered by status, type, priority, epic, or sprint.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "backlog",
                "todo",
                "in_progress",
                "in_review",
                "done"
              ],
              "description": "Filter by workflow status."
            },
            "type": {
              "type": "string",
              "enum": [
                "bug",
                "feature",
                "task"
              ],
              "description": "Filter by ticket type."
            },
            "priority": {
              "type": "string",
              "enum": [
                "P0",
                "P1",
                "P2"
              ],
              "description": "Filter by priority."
            },
            "epic_id": {
              "type": "string",
              "format": "uuid",
              "description": "Filter by epic id."
            },
            "sprint_id": {
              "type": "string",
              "format": "uuid",
              "description": "Filter by sprint id."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25,
              "description": "Maximum rows to return."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_ticket",
        "title": "Get ticket",
        "description": "Fetch one ticket with its description, acceptance criteria, labels and comments.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "ticket": {
              "type": "string",
              "minLength": 1,
              "description": "Ticket id (uuid) or ticket key such as AUTH-101."
            }
          },
          "required": [
            "ticket"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_ticket",
        "title": "Create ticket",
        "description": "Create a new ticket (story) in the backlog with title, description and acceptance criteria.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 3,
              "maxLength": 200,
              "description": "Short ticket title."
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "description": "What needs to be done."
            },
            "acceptance_criteria": {
              "type": "string",
              "minLength": 1,
              "description": "What 'done' looks like."
            },
            "type": {
              "type": "string",
              "enum": [
                "bug",
                "feature",
                "task"
              ],
              "default": "task"
            },
            "priority": {
              "type": "string",
              "enum": [
                "P0",
                "P1",
                "P2"
              ],
              "default": "P2"
            },
            "story_points": {
              "type": "integer",
              "minimum": 1,
              "maximum": 21,
              "default": 3
            },
            "epic_id": {
              "type": "string",
              "format": "uuid",
              "description": "Optional epic to attach the ticket to."
            },
            "sprint_id": {
              "type": "string",
              "format": "uuid",
              "description": "Optional sprint to attach the ticket to."
            }
          },
          "required": [
            "title",
            "description",
            "acceptance_criteria"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "update_ticket_status",
        "title": "Update ticket status",
        "description": "Move a ticket to another workflow status (backlog, todo, in_progress, in_review, done).",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "ticket": {
              "type": "string",
              "minLength": 1,
              "description": "Ticket id (uuid) or ticket key such as AUTH-101."
            },
            "status": {
              "type": "string",
              "enum": [
                "backlog",
                "todo",
                "in_progress",
                "in_review",
                "done"
              ]
            }
          },
          "required": [
            "ticket",
            "status"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "sprint_summary",
        "title": "Sprint summary",
        "description": "Summarise a sprint: ticket counts and story points by status, plus completion percentage.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "sprint_id": {
              "type": "string",
              "format": "uuid",
              "description": "Sprint id. Defaults to the active sprint."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
